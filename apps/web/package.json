{
  "name": "@hallederiz/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:clean": "node -e \"const fs=require('fs'); for (const p of ['.runtime-next','.runtime-next-dev','tsconfig.tsbuildinfo']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} } console.log('web dev cache cleaned');\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"console.log('clean: no-op for @hallederiz/web')\""
  },
  "dependencies": {
    "@hallederiz/domain": "workspace:*",
    "@hallederiz/sdk": "workspace:*",
    "@hallederiz/types": "workspace:*",
    "@hallederiz/ui": "workspace:*",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "jsdom": "30.0.1",
    "react-test-renderer": "19.2.8",
    "typescript": "^7.0.2"
  }
}
